# Copy this file to .env and adjust values before running `docker compose up --build`.
# Nothing in this file is a real secret — generate your own for any non-local use.

# --- PostgreSQL ---
POSTGRES_USER=jobportal
POSTGRES_PASSWORD=jobportal_dev_password
POSTGRES_DB=jobportal

# --- Backend ---
# Must match the POSTGRES_* values above; "db" is the Docker Compose service name.
DATABASE_URL=postgresql+psycopg2://jobportal:jobportal_dev_password@db:5432/jobportal

# Used to sign JWTs. Generate a real one with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-64-char-hex-string-before-any-real-use

# How long an access token stays valid. There is no refresh-token flow (see README
# "Known Limitations"), so this is the user's full session length.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Browser origin allowed by CORS. Must match the host-mapped frontend port below.
FRONTEND_ORIGIN=http://localhost:3001

# Seed demo HR/Candidate accounts, jobs, and applications on first boot. The seed
# is idempotent (checks a marker record) so leaving this on is safe long-term.
SEED_DEMO_DATA=true

# Where uploaded resumes are stored inside the backend container.
UPLOAD_DIR=/app/uploads

# Rate limits on the two unauthenticated auth endpoints, using slowapi's
# "<count>/<period>" syntax. In-memory, per-process (see README Known Limitations).
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute

# --- Frontend (build-time; baked into the static bundle, not read at runtime) ---
# Must be reachable from the user's browser, so this is the host-mapped backend
# port, never the Docker-internal service name "backend".
VITE_API_URL=http://localhost:8001
